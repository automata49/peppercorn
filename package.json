{
  "name": "peppercorn-capital",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-b-app-icons.mjs && vite",
    "build": "node scripts/generate-b-app-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "harness:sync": "node scripts/harness/sync.mjs",
    "harness:check": "node scripts/harness/check.mjs",
    "test:position-db": "node supabase/tests/position_growth.verify.mjs",
    "test:etf-rs": "node supabase/tests/etf_rs.verify.mjs",
    "test:universe-db": "node supabase/tests/universe.verify.mjs",
    "test:temperature-db": "node supabase/tests/temperature.verify.mjs",
    "test:identity": "playwright test tests/design-baseline.spec.ts tests/brand.spec.ts tests/theme-system.spec.ts tests/compact-editorial.spec.ts tests/compact-titlebar.spec.ts tests/discovery.spec.ts tests/visual-identity-regression.spec.ts",
    "test:ui": "playwright test",
    "verify": "npm run harness:check && npm run test:position-db && npm run test:etf-rs && npm run test:universe-db && npm run test:temperature-db && npm run build && npm run test:identity && npm run test:ui",
    "test:visual-identity": "playwright test tests/visual-identity-regression.spec.ts",
    "test:four-screens": "playwright test tests/four-screen-visual.spec.ts --update-snapshots=none"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tabs": "1.1.22",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lightweight-charts": "5.2.1",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.51.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "^8.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
