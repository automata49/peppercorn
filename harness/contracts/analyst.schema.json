{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "title":"Pepper AI Analyst output v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","criteria_version","prompt_version","provider","model","generated_at","as_of","market","ticker","strategy","status","facts","interpretation","risks","next_checks","missing_data"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "criteria_version":{"type":"string","minLength":1},
    "prompt_version":{"type":"string","minLength":1},
    "provider":{"type":"string","minLength":1},
    "model":{"type":"string","minLength":1},
    "generated_at":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}T"},
    "as_of":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "market":{"enum":["US","KR"]},"ticker":{"type":"string","minLength":1},
    "strategy":{"enum":["swing","position_growth"]},
    "status":{"enum":["ok","insufficient_data","provider_unavailable","error"]},
    "facts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["claim","evidence_id","source_url","as_of"],"properties":{"claim":{"type":"string","minLength":1},"evidence_id":{"type":"string","minLength":1},"source_url":{"type":"string","pattern":"^https://"},"as_of":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}}}},
    "interpretation":{"type":"string"},
    "risks":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "next_checks":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "missing_data":{"type":"array","items":{"type":"string","minLength":1}}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"ok"}}},"then":{"properties":{"facts":{"minItems":1},"missing_data":{"maxItems":0}}}},
    {"if":{"properties":{"status":{"const":"insufficient_data"}}},"then":{"properties":{"missing_data":{"minItems":1}}}}
  ]
}
