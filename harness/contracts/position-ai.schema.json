{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pepper Position Growth extracted evidence and draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "criteria_version", "prompt_version", "task", "status", "market", "ticker", "as_of", "input_hash", "provider", "model", "generated_at", "items", "missing_data"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "criteria_version": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "task": {"enum": ["kpi", "fisher", "thesis", "counterargument"]},
    "status": {"enum": ["ok", "insufficient_data", "provider_unavailable", "error"]},
    "market": {"enum": ["US", "KR"]},
    "ticker": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T"},
    "missing_data": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "provenance"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "provenance": {"enum": ["verified", "unverified"]},
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_url", "section", "paragraph", "as_of", "filed_at", "content_hash"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "source_url": {"type": "string", "pattern": "^https://"},
              "section": {"type": "string", "minLength": 1},
              "paragraph": {"type": "string", "minLength": 1},
              "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "filed_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "allOf": [{"if": {"properties": {"provenance": {"const": "verified"}}}, "then": {"required": ["citation"]}}]
      }
    }
  }
}
